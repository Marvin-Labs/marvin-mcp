        "title": "DocumentSection",
        "type": "object"
      }
    },
    "properties": {
      "content": {
        "title": "Content",
        "type": "string"
      },
      "document_type": {
        "title": "Document Type",
        "type": "string"
      },
      "end_token_offset": {
        "title": "End Token Offset",
        "type": "integer"
      },
      "full_id": {
        "title": "Full Id",
        "type": "string"
      },
      "has_more": {
        "description": "More follows: read on from `end_token_offset`.",
        "title": "Has More",
        "type": "boolean"
      },
      "id": {
        "description": "The id you passed.",
        "title": "Id",
        "type": "string"
      },
      "kind": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Kind"
      },
