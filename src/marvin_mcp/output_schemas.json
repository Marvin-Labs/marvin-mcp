          "has_more"
        ],
        "title": "CompanyRelationships",
        "type": "object"
      },
      "RelatedCompanyObject": {
        "description": "A company related to another, with every way the two are related.",
        "properties": {
          "company": {
            "$ref": "#/$defs/CompanyReference"
          },
