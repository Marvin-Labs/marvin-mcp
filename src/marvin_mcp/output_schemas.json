          "competitor",
          "partner",
          "customer",
          "supplier"
        ],
        "title": "RelationshipType",
        "type": "string"
      }
    },
    "description": "A company's profile and its related companies.",
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "industry": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
