  "query_financials": {
    "$defs": {
      "CompanyFinancialResult": {
        "description": "One series of figures, all on one basis.",
        "properties": {
          "basis": {
            "description": "common: normalised onto the common taxonomy; as_reported: the company's own tagged line",
            "enum": [
              "common",
              "as_reported"
            ],
            "title": "Basis",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "dimension": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Dimension"
          },
          "element": {
            "description": "The element the figures are read from",
            "title": "Element",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "statement": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Statement"
          },
          "values": {
            "items": {
              "$ref": "#/$defs/ValuePeriodPair"
            },
            "title": "Values",
            "type": "array"
          }
        },
        "required": [
          "label",
          "basis",
          "element",
          "values"
        ],
        "title": "CompanyFinancialResult",
        "type": "object"
      },
      "MissingPeriods": {
        "description": "Requested periods of a query without a value, among those the company\nhas data for. One entry per distinct reason, not per period: a wide\ngrid's gaps were most of a return, and the model is shown them again on\nevery later request of the turn.",
        "properties": {
          "periods": {
            "items": {
              "properties": {
                "canonical_period_text": {
                  "readOnly": true,
                  "title": "Canonical Period Text",
                  "type": "string"
                },
                "downscaled_period_text": {
                  "readOnly": true,
                  "title": "Downscaled Period Text",
                  "type": "string"
                },
                "period_display_name": {
                  "readOnly": true,
                  "title": "Period Display Name",
                  "type": "string"
                },
                "period_number": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "const": "irregular",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Period Number"
                },
                "period_type": {
                  "title": "Period Type",
                  "type": "string"
                },
                "year": {
                  "title": "Year",
                  "type": "integer"
                }
              },
              "required": [
                "year",
                "period_type"
              ],
              "title": "ReportingPeriod",
              "type": "object"
            },
            "title": "Periods",
            "type": "array"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          }
        },
        "required": [
          "periods"
        ],
        "title": "MissingPeriods",
        "type": "object"
      },
      "QueryResult": {
        "description": "One metric the caller's queries were decomposed into: the figures\nfound for it, on one basis per series, and its gaps.",
        "properties": {
          "from_query": {
            "description": "Index of the caller's query it was decomposed from",
            "title": "From Query",
            "type": "integer"
          },
          "missing": {
            "items": {
              "$ref": "#/$defs/MissingPeriods"
            },
            "title": "Missing",
            "type": "array"
          },
          "query": {
            "description": "The metric and periods this result answers",
            "title": "Query",
            "type": "string"
          },
          "series": {
            "items": {
              "$ref": "#/$defs/CompanyFinancialResult"
            },
            "title": "Series",
            "type": "array"
          }
        },
        "required": [
          "query",
          "from_query"
        ],
        "title": "QueryResult",
        "type": "object"
      },
      "Redirect": {
        "description": "A caller's query served by another tool.",
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "statement": {
            "title": "Statement",
            "type": "string"
          },
          "use": {
            "const": "get_financial_statements",
            "default": "get_financial_statements",
            "title": "Use",
            "type": "string"
          }
        },
        "required": [
          "query",
          "statement"
        ],
        "title": "Redirect",
        "type": "object"
      },
      "Usage": {
        "description": "What a call was billed, and the wallet balance after it.\n\n``cost_usd`` equals the ledger rows booked for the call (for a retry\nunder the same ``Idempotency-Key``, the first request's); a failed call,\nor one whose booking failed, reports 0. ``balance_usd`` is read from the ledger, so it includes this\ncall's charges; it may be negative.",
        "properties": {
          "balance_usd": {
            "title": "Balance Usd",
            "type": "number"
          },
          "cached_input_tokens": {
            "default": 0,
            "title": "Cached Input Tokens",
            "type": "integer"
          },
          "cost_usd": {
            "title": "Cost Usd",
            "type": "number"
          },
          "input_tokens": {
            "default": 0,
            "description": "Billed uncached input tokens.",
            "title": "Input Tokens",
            "type": "integer"
          },
          "llm_usd": {
            "default": 0.0,
            "title": "Llm Usd",
            "type": "number"
          },
          "output_tokens": {
            "default": 0,
            "description": "Billed output tokens, thinking included.",
            "title": "Output Tokens",
            "type": "integer"
          },
          "retrieval_calls": {
            "default": 0,
            "title": "Retrieval Calls",
            "type": "integer"
          },
          "retrieval_usd": {
            "default": 0.0,
            "title": "Retrieval Usd",
            "type": "number"
          }
        },
        "required": [
          "cost_usd",
          "balance_usd"
        ],
        "title": "Usage",
        "type": "object"
      },
      "ValuePeriodPair": {
        "additionalProperties": true,
        "type": "object"
      }
    },
    "description": "``query_financials``'s own result, plus what the call cost.",
    "properties": {
      "periods_without_data": {
        "description": "Requested periods the company has no financial data for at all; not repeated under missing.",
        "items": {
          "properties": {
            "canonical_period_text": {
              "readOnly": true,
              "title": "Canonical Period Text",
              "type": "string"
            },
            "downscaled_period_text": {
              "readOnly": true,
              "title": "Downscaled Period Text",
              "type": "string"
            },
            "period_display_name": {
              "readOnly": true,
              "title": "Period Display Name",
              "type": "string"
            },
            "period_number": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "const": "irregular",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Period Number"
            },
            "period_type": {
              "title": "Period Type",
              "type": "string"
            },
            "year": {
              "title": "Year",
              "type": "integer"
            }
          },
          "required": [
            "year",
            "period_type"
          ],
          "title": "ReportingPeriod",
          "type": "object"
        },
        "title": "Periods Without Data",
        "type": "array"
      },
      "redirects": {
        "items": {
          "$ref": "#/$defs/Redirect"
        },
        "title": "Redirects",
        "type": "array"
      },
      "results": {
        "items": {
          "$ref": "#/$defs/QueryResult"
        },
        "title": "Results",
        "type": "array"
      },
      "unrecognised_periods": {
        "description": "Requested labels that are not reporting periods (e.g. calendar dates), so nothing was looked up for them. Periods are fiscal: FY-2024, 3Q-2024, 1H-2024, 9M-2024.",
        "items": {
          "type": "string"
        },
        "title": "Unrecognised Periods",
        "type": "array"
      },
      "usage": {
        "anyOf": [
          {
            "$ref": "#/$defs/Usage"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "What this call cost."
      }
    },
    "required": [
      "results"
    ],
    "title": "QueryFinancialsResponse",
    "type": "object"
  },
