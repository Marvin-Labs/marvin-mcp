{
  "explore_document": {
    "$defs": {
      "Usage": {
        "description": "What a call was billed, and the wallet balance after it.\n\n``cost_usd`` equals the ledger rows booked for the call (for a retry\nunder the same ``Idempotency-Key``, the first request's); a failed call,\nor one whose booking failed, reports 0. ``balance_usd`` is read from the ledger, so it includes this\ncall's charges; it may be negative.",
        "properties": {
          "balance_usd": {
            "title": "Balance Usd",
            "type": "number"
          },
          "cached_input_tokens": {
            "default": 0,
            "title": "Cached Input Tokens",
            "type": "integer"
          },
          "cost_usd": {
            "title": "Cost Usd",
            "type": "number"
          },
          "input_tokens": {
            "default": 0,
            "description": "Billed uncached input tokens.",
            "title": "Input Tokens",
            "type": "integer"
          },
          "llm_usd": {
            "default": 0.0,
            "title": "Llm Usd",
            "type": "number"
          },
          "output_tokens": {
            "default": 0,
            "description": "Billed output tokens, thinking included.",
            "title": "Output Tokens",
            "type": "integer"
          },
          "retrieval_calls": {
            "default": 0,
            "title": "Retrieval Calls",
            "type": "integer"
          },
          "retrieval_usd": {
            "default": 0.0,
            "title": "Retrieval Usd",
            "type": "number"
          }
        },
        "required": [
          "cost_usd",
          "balance_usd"
        ],
        "title": "Usage",
        "type": "object"
      }
    },
    "properties": {
      "coverage": {
        "anyOf": [
          {
            "enum": [
              "full",
              "section",
              "narrative",
              "ranked",
              "sampled"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "What was read: the whole document, a section, the parts that best match the question, or a sample.",
        "title": "Coverage"
      },
      "document_date": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Document Date"
      },
      "document_type": {
        "title": "Document Type",
        "type": "string"
      },
      "earnings_period": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Earnings Period"
      },
      "full_id": {
        "title": "Full Id",
        "type": "string"
      },
      "id": {
        "description": "The id you passed.",
        "title": "Id",
        "type": "string"
      },
      "kind": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Kind"
      },
      "link": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Link"
      },
      "not_found": {
        "description": "The document does not address the question.",
        "title": "Not Found",
        "type": "boolean"
      },
      "note": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Note"
      },
      "passages": {
        "description": "Verbatim passages from the document that answer the question.",
        "items": {
          "type": "string"
        },
        "title": "Passages",
        "type": "array"
      },
      "summary": {
        "title": "Summary",
        "type": "string"
      },
      "title": {
        "title": "Title",
        "type": "string"
      },
      "usage": {
        "anyOf": [
          {
            "$ref": "#/$defs/Usage"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "What this call cost."
      }
    },
    "required": [
      "id",
      "full_id",
      "document_type",
      "title",
      "passages",
      "summary",
      "not_found"
    ],
    "title": "ExploreDocumentResponse",
    "type": "object"
  },
  "find_company": {
    "$defs": {
      "CompanyReference": {
        "description": "A company, as a search result or a related company.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "industry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Industry"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "sector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sector"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "CompanyReference",
        "type": "object"
      }
    },
    "properties": {
      "data": {
        "items": {
          "$ref": "#/$defs/CompanyReference"
        },
        "title": "Data",
        "type": "array"
      },
      "has_more": {
        "default": false,
        "title": "Has More",
        "type": "boolean"
      },
      "next_cursor": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Next Cursor"
      },
      "object": {
        "default": "list",
        "title": "Object",
        "type": "string"
      }
    },
    "required": [
      "data"
    ],
    "title": "ListResponseContainer[CompanyReference]",
    "type": "object"
  },
  "get_company": {
    "$defs": {
      "CompanyReference": {
        "description": "A company, as a search result or a related company.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
